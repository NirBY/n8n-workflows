# Docker / host paths
TZ=Asia/Jerusalem
N8N_POSTGRES_DATA_DIR=/volume2/docker/n8n/postgres
N8N_DATA_DIR=/volume2/docker/n8n/data
N8N_FILES_DIR=/volume2/docker/n8n/files
N8N_LOGS_DIR=/volume2/docker/n8n/logs
AI_PROMPTS_DIR=/volume2/docker/AI/prompts
AI_TEMPLATES_DIR=/volume2/docker/AI/templates
AI_KNOWLEDGE_DIR=/volume2/docker/AI/knowledge
AI_GIT_DIR=/volume2/docker/AI/git
AI_APPROVALS_DIR=/volume2/docker/AI/approvals
AI_LOGS_DIR=/volume2/docker/AI/logs

# n8n public URLs
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.example.com:5678/
N8N_EDITOR_BASE_URL=http://n8n.example.com:5678/
PUBLIC_N8N_BASE_URL=http://n8n.example.com:5678
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=1
N8N_PUSH_BACKEND=websocket

# Security
N8N_ENCRYPTION_KEY=replace-with-random-n8n-encryption-key
DEPLOY_WEBHOOK_SECRET=replace-with-random-github-webhook-secret
DEPLOY_APPROVAL_TOKEN=replace-with-random-telegram-approval-token
NODES_EXCLUDE=[]

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_APPROVAL_CHAT_ID=123456789

# Repository defaults
DEPLOY_REPO=OWNER/REPO
DEPLOY_BRANCH=refs/heads/main
DEPLOY_WORKFLOW_PATH=staging/personal-productivity-safe.json
GITHUB_TOKEN=

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Optional workflow references
MAC_MINI_OPENWEBUI_URL=
MAC_MINI_OLLAMA_URL=
