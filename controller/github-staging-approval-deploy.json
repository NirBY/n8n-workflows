                      "id":  "f75aa466-6a95-4ef5-b8b3-d6e91c5a0f20",
                      "name":  "GitHub Deploy Webhook",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2,
                      "position":  [
                                       -900,
                                       -180
                                   ],
                      "webhookId":  "github-workflow-deploy"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const item = $input.first().json;\nconst body = item.body || item;\nconst headers = item.headers || {};\nconst headerSecret = headers[\u0027x-n8n-deploy-secret\u0027] || headers[\u0027X-N8N-Deploy-Secret\u0027];\nif (!$env.DEPLOY_WEBHOOK_SECRET) {\n  throw new Error(\u0027DEPLOY_WEBHOOK_SECRET is required\u0027);\n}\nif (headerSecret !== $env.DEPLOY_WEBHOOK_SECRET) {\n  throw new Error(\u0027Invalid deploy webhook secret\u0027);\n}\nconst repo = body.repository?.full_name || $env.DEPLOY_REPO || \u0027OWNER/REPO\u0027;\nif (!/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(repo)) {\n  throw new Error(`Refusing unsafe repo: ${repo}`);\n}\nconst ref = body.ref || $env.DEPLOY_BRANCH || \u0027refs/heads/main\u0027;\nconst branch = ref.replace(\u0027refs/heads/\u0027, \u0027\u0027);\nif (branch.includes(\u0027..\u0027) || !/^[A-Za-z0-9._/-]+$/.test(branch)) {\n  throw new Error(`Refusing unsafe branch: ${branch}`);\n}\nconst workflowPath = body.workflow_path || body.workflowPath || $env.DEPLOY_WORKFLOW_PATH || \u0027staging/personal-productivity-safe.json\u0027;\nif (!workflowPath.startsWith(\u0027staging/\u0027) || workflowPath.includes(\u0027..\u0027) || !/^[A-Za-z0-9._/-]+$/.test(workflowPath)) {\n  throw new Error(`Refusing unsafe workflow path: ${workflowPath}`);\n}\nconst fileName = workflowPath.split(\u0027/\u0027).pop();\nconst stagingInput = `/files/git/${workflowPath}`;\nconst productionInput = `/files/git/production/${fileName}`;\nconst downloadUrl = `https://raw.githubusercontent.com/${repo}/${branch}/${workflowPath}`;\nconst displayName = fileName.replace(/\\.json$/, \u0027\u0027).replace(/[-_]/g, \u0027 \u0027);\nconst publishStaging = String($env.DEPLOY_PUBLISH_STAGING || \u0027\u0027).toLowerCase() === \u0027true\u0027;\nconst downloadJson = `const fs=require(\u0027fs\u0027);const [url,out]=process.argv.slice(1);const headers={};if(process.env.GITHUB_TOKEN)headers.Authorization=\u0027Bearer \u0027+process.env.GITHUB_TOKEN;fetch(url,{headers}).then(async r=\u003e{if(!r.ok)throw new Error(\u0027Download failed \u0027+r.status+\u0027 \u0027+r.statusText);fs.writeFileSync(out,await r.text());}).catch(e=\u003e{console.error(e.message);process.exit(1);});`;\nconst hardenJson = `const fs=require(\u0027fs\u0027);const p=process.argv[1];const n=process.argv[2];const j=JSON.parse(fs.readFileSync(p,\u0027utf8\u0027));j.active=false;j.name=(j.name||n)+\u0027 - Staging Candidate\u0027;fs.writeFileSync(p,JSON.stringify(j,null,2));`;\nconst readIdJson = `const fs=require(\u0027fs\u0027);const j=JSON.parse(fs.readFileSync(process.argv[1],\u0027utf8\u0027));process.stdout.write(j.id||\u0027\u0027);`;\nconst importCommandParts = [\n  `mkdir -p \u0027/files/git/staging\u0027`,\n  `node -e \"${downloadJson}\" \u0027${downloadUrl}\u0027 \u0027${stagingInput}\u0027`,\n  `node -e \"${hardenJson}\" \u0027${stagingInput}\u0027 \u0027${displayName}\u0027`,\n  `n8n import:workflow --input=\u0027${stagingInput}\u0027`\n];\nif (publishStaging) {\n  importCommandParts.push(`WORKFLOW_ID=$(node -e \"${readIdJson}\" \u0027${stagingInput}\u0027) \u0026\u0026 test -n \"$WORKFLOW_ID\" \u0026\u0026 n8n publish:workflow --id=\"$WORKFLOW_ID\"`);\n}\nconst importCommand = importCommandParts.join(\u0027 \u0026\u0026 \u0027);\nconst baseUrl = ($env.PUBLIC_N8N_BASE_URL || \u0027\u0027).replace(/\\/$/, \u0027\u0027);\nif (!baseUrl) {\n  throw new Error(\u0027PUBLIC_N8N_BASE_URL is required to build the Telegram approval link\u0027);\n}\nif (!$env.DEPLOY_APPROVAL_TOKEN) {\n  throw new Error(\u0027DEPLOY_APPROVAL_TOKEN is required\u0027);\n}\nconst approvalUrl = `${baseUrl}/webhook/workflow-promote-production?token=${encodeURIComponent($env.DEPLOY_APPROVAL_TOKEN)}\u0026source=${encodeURIComponent(stagingInput)}\u0026target=${encodeURIComponent(productionInput)}\u0026name=${encodeURIComponent(fileName)}`;\nconst telegramText = [\n  publishStaging ? \u0027Staging workflow import completed and publish was requested. Review it in n8n before approving production.\u0027 : \u0027Staging workflow import completed as an unpublished draft. Publish and review it in n8n before approving production.\u0027,\n  `Workflow: ${fileName}`,\n  `Repo: ${repo}`,\n  `Branch: ${branch}`,\n  `Source path: ${workflowPath}`,\n  `Publish staging: ${publishStaging}`\n].join(\u0027\\n\u0027);\nreturn [{ json: { repo, branch, workflowPath, fileName, stagingInput, productionInput, downloadUrl, approvalUrl, telegramText, publishStaging, importCommand } }];"
                                     },
