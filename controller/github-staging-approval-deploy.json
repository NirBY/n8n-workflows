                      "id":  "9dd0685c-1769-45e7-ac71-23e61ab2e3df",
                      "name":  "Telegram Approval Webhook",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2,
                      "position":  [
                                       -900,
                                       180
                                   ],
                      "webhookId":  "workflow-promote-production"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const item = $input.first().json;\nconst query = item.query || {};\nif (!$env.DEPLOY_APPROVAL_TOKEN || query.token !== $env.DEPLOY_APPROVAL_TOKEN) {\n  throw new Error(\u0027Invalid production approval token\u0027);\n}\nconst source = query.source;\nconst target = query.target;\nconst name = query.name || \u0027workflow.json\u0027;\nif (!source?.startsWith(\u0027/files/git/staging/\u0027) || !target?.startsWith(\u0027/files/git/production/\u0027) || source.includes(\u0027..\u0027) || target.includes(\u0027..\u0027)) {\n  throw new Error(\u0027Refusing unsafe promotion paths\u0027);\n}\nconst displayName = name.replace(/\\.json$/, \u0027\u0027).replace(/[-_]/g, \u0027 \u0027);\nconst hardenJson = `const fs=require(\u0027fs\u0027);const p=process.argv[1];const n=process.argv[2];const j=JSON.parse(fs.readFileSync(p,\u0027utf8\u0027));j.active=false;j.name=(j.name||n).replace(/ - Staging Candidate$/,\u0027\u0027)+\u0027 - Production Candidate\u0027;fs.writeFileSync(p,JSON.stringify(j,null,2));`;\nconst promoteCommand = [\n  `test -f \u0027${source}\u0027`,\n  `mkdir -p \u0027/files/git/production\u0027`,\n  `cp \u0027${source}\u0027 \u0027${target}\u0027`,\n  `node -e \"${hardenJson}\" \u0027${target}\u0027 \u0027${displayName}\u0027`,\n  `n8n import:workflow --input=\u0027${target}\u0027`\n].join(\u0027 \u0026\u0026 \u0027);\nconst telegramText = [\n  \u0027Production workflow import completed after approval.\u0027,\n  `Workflow: ${name}`,\n  `Imported file: ${target}`,\n  \u0027The imported workflow is forced inactive; activate it manually after final review.\u0027\n].join(\u0027\\n\u0027);\nreturn [{ json: { source, target, name, promoteCommand, telegramText, responseText: `Production import queued for ${name}. You can close this page.` } }];"
                                     },
